# HyuuCdn Environment Configuration

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Public Anon Key (for client-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (Required for server-side uploads & deletions)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Public Base URL of this HyuuCdn instance (e.g. https://hyuucdn.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
